# MafundiPro backend configuration
APP_NAME=MafundiPro
APP_ENVIRONMENT=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Local PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=mafundipro
POSTGRES_USER=mafundipro_app
POSTGRES_PASSWORD=replace-with-a-local-password

# Authentication secret
# Generate a unique secret locally. Never commit the actual secret.
AUTH_SECRET_KEY=replace-with-a-generated-secret

# Server-managed sessions
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_DAYS=7
SESSION_COOKIE_NAME=mafundipro_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Comma-separated trusted browser origins.
# Example: FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8081
FRONTEND_ORIGINS=

# CSRF protection
CSRF_COOKIE_NAME=mafundipro_csrf
